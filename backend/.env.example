# Application
log_level=INFO
backend_port=8000

# Database (prefix: db_)
# Set the DB_HOST to 'db' when running in Docker, as the service name in docker-compose is 'db' 
# or 'localhost' when running locally
db_host=localhost
db_port=5432
db_username=postgres
db_password=password
db_name=daily

# JWT (prefix: jwt_)
jwt_secret_key=change-me-to-a-strong-secret
jwt_algorithm=HS256
jwt_access_token_expire_minutes=30
jwt_refresh_token_expire_days=7
jwt_login_token_expire_minutes=5

# Authsch OAuth (prefix: authsch_)
authsch_client_id=
authsch_client_secret=
authsch_redirect_uri=http://localhost:8000/api/v1/auth/authsch/callback
authsch_token_url=
authsch_userinfo_url=

# Google OAuth (prefix: google_)
google_client_id=
google_client_secret=
google_redirect_uri=http://localhost:8000/api/v1/auth/google/callback
google_token_url=https://oauth2.googleapis.com/token
google_userinfo_url=https://www.googleapis.com/oauth2/v3/userinfo

# Frontend (prefix: frontend_)
frontend_auth_callback=http://localhost:8000/auth/callback
frontend_cors_origins=http://localhost:3000,http://127.0.0.1:3000,http://maxi.sch.bme.hu:3000
